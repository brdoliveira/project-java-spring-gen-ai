{
  "testCommand": "node scripts/run-spec-tests.mjs",
  "reporter": "jest-json",
  "reporterOutputFile": ".spec/verification/test-results.json",
  "testGlobs": [
    "src/test/**/*.java",
    "posture-service/src/test/**/*.java"
  ],
  "srcGlobs": [
    "pom.xml",
    "posture-service/pom.xml",
    ".mvn/wrapper/maven-wrapper.properties",
    "mvnw",
    "mvnw.cmd",
    "scripts/run-spec-tests.mjs",
    ".github/workflows/ci.yml",
    "docker/dev/compose.yml",
    "docker/dev/Dockerfile",
    "docker/dev/posture-service.Dockerfile",
    "README.md",
    "gen-ai-with-java-spring.postman_collection.json",
    "src/main/resources/application.yml",
    "src/main/resources/application-local.yml",
    "src/main/resources/application-prod.yml",
    "src/main/resources/db/data.sql",
    "src/main/resources/db/schema.sql",
    "src/main/resources/db/migration/**",
    "posture-service/src/main/resources/application.yml",
    "posture-service/src/main/resources/application-local.yml",
    "posture-service/src/main/resources/application-prod.yml",
    "posture-service/src/main/resources/db/data.sql",
    "posture-service/src/main/resources/db/schema.sql",
    "posture-service/src/main/resources/db/local-data.sql",
    "posture-service/src/main/resources/db/migration/**",
    "src/main/java/com/genai/java/spring/security/**",
    "src/main/java/com/genai/java/spring/aiagent/controller/SecurityReviewController.java",
    "src/main/java/com/genai/java/spring/aiagent/dataaccess/helper/ReviewStateRepositoryHelper.java",
    "src/main/java/com/genai/java/spring/aiagent/dataaccess/repository/ReviewStateRepository.java",
    "src/main/java/com/genai/java/spring/aiagent/dataaccess/repository/impl/ReviewStateRepositoryImpl.java",
    "src/main/java/com/genai/java/spring/aiagent/dto/ReviewState.java",
    "src/main/java/com/genai/java/spring/aiagent/dto/ApprovalRequest.java",
    "src/main/java/com/genai/java/spring/aiagent/dto/FollowUpRequestDto.java",
    "src/main/java/com/genai/java/spring/aiagent/service/SecurityReviewService.java",
    "src/main/java/com/genai/java/spring/aiagent/service/impl/SecurityReviewServiceImpl.java",
    "src/main/java/com/genai/java/spring/aiagent/service/impl/FileStorageServiceImpl.java",
    "src/main/java/com/genai/java/spring/aiagent/tools/posture/PostureTools.java",
    "src/main/java/com/genai/java/spring/aiagent/tools/web/WebTools.java",
    "src/main/java/com/genai/java/spring/config/AIProviderConfig.java",
    "src/main/java/com/genai/java/spring/config/ProviderProperties.java",
    "src/main/java/com/genai/java/spring/multimodality/texttoimage/GeneratedImageStorage.java",
    "src/main/java/com/genai/java/spring/multimodality/texttoimage/MarketingAssetController.java",
    "src/main/java/com/genai/java/spring/rag/evaluation/**",
    "src/main/java/com/genai/java/spring/rag/rerank/processor/RerankPostProcessor.java",
    "src/test/resources/rag/evaluation/golden-dataset.json"
  ],
  "ignoreGlobs": [
    ".git/**",
    ".spec/**",
    "target/**",
    "posture-service/target/**"
  ],
  "paralelo": {
    "maxParalelas": 3,
    "model": "gpt-5.6-terra",
    "esforco": "medium",
    "sandbox": "workspace-write",
    "resumoModel": "gpt-5.6-luna"
  }
}
